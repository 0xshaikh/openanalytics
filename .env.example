# openanalytics environment — copy to .env and set a real random salt.
# Generate one with:  python3 -c "import secrets;print(secrets.token_hex(24))"

# Where the SQLite database lives. Mount a volume here for persistence.
OPENANALYTICS_DB=/data/analytics.db

# Bind address and port.
OPENANALYTICS_HOST=0.0.0.0
OPENANALYTICS_PORT=8000

# Salt for visitor hashing. Use a random string so visitors are not linkable
# across installs.
OPENANALYTICS_SALT=change-me-to-a-random-string

# Comma-separated origins allowed to POST hits. "*" allows any origin.
OPENANALYTICS_CORS=*

# "min" serves the minified snippet (~1.7 KB); "dev" serves the readable source.
OPENANALYTICS_SNIPPET=min
